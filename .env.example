# ============================================================================
# GOVERNMENT SIMULATOR — ENVIRONMENT VARIABLES
#
# Copy this file to `.env` and fill in the real values.
#   .env         is git-ignored and holds real secrets. NEVER commit it.
#   .env.example is committed and is the documented list of what is required.
#
# See DESIGN.md §4.1 for the Supabase/Prisma configuration rules.
# ============================================================================


# ----------------------------------------------------------------------------
# SUPABASE — DATABASE (Prisma)
#
# Prisma needs BOTH URLs. This is the single most common setup mistake.
#
#   DATABASE_URL  -> transaction pooler, port 6543, with ?pgbouncer=true
#                    Consumed by src/lib/prisma.ts (the running application).
#
#   DIRECT_URL    -> direct connection,  port 5432
#                    Consumed by prisma.config.ts (the Prisma CLI).
#                    Migrations take advisory locks and issue DDL, neither of
#                    which survives a transaction pooler. A migration run
#                    through the pooler typically just hangs.
#
# NOTE FOR PRISMA 7: these do NOT go in schema.prisma. Putting them there is a
# hard validation error (P1012). See DESIGN.md section 4.1.
#
# WHERE TO FIND THESE
# Supabase dashboard -> Connect (top bar) -> ORMs tab -> Prisma.
# Supabase shows both strings there already labelled for this exact purpose.
#
# WARNING — PASSWORD ENCODING
# If your database password contains special characters they MUST be
# percent-encoded or the URL silently breaks with a confusing error:
#     !  -> %21        #  -> %23        $  -> %24
#     &  -> %26        '  -> %27        (  -> %28        )  -> %29
#     *  -> %2A        +  -> %2B        /  -> %2F        :  -> %3A
#     =  -> %3D        ?  -> %3F        @  -> %40
# ----------------------------------------------------------------------------

DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"


# ----------------------------------------------------------------------------
# SUPABASE — AUTH / CLIENT
#
# These two are safe to expose to the browser (that is what NEXT_PUBLIC_ means)
# and are protected by Row Level Security, not by secrecy.
# Find them in: Supabase dashboard -> Project Settings -> API
# ----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"


# ----------------------------------------------------------------------------
# SUPABASE — SERVER ONLY
#
# The service role key bypasses Row Level Security entirely. It must NEVER be
# prefixed with NEXT_PUBLIC_ and must never reach the browser.
# Only add this if a server-side operation genuinely requires it.
# ----------------------------------------------------------------------------

# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
